exports[`the MCP tool contracts mediaStatusTool keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Media Status",
  },
  "description": "Check whether a media uploaded with adjust set to true finished adjusting to the platforms' limits, using the media id returned by uploadFromUrlTool, the public API (POST /public/v1/upload or /public/v1/upload-from-url) or the Sharek CLI (sharek upload <file>).
Files the user uploaded through the upload widget (uploadWidgetTool) have no id until they are listed, so check those with uploadWidgetStatusTool and its sessionId instead.
Only a media with the status "processing" needs checking: check it once, and while it is still "processing" tell the user it is being adjusted and check again when they ask - never wait or call it again in the same turn. Don't publish a post with its path until it is "ready": a post published while it is processing uses the original, unadjusted file.
"ready" means the adjusted file is in place at the same path. "ready" with a warning means the adjustment failed and the original file was kept and will be used for publishing.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "The media id returned by the upload",
        "type": "string",
      },
    },
    "required": [
      "id",
    ],
    "type": "object",
  },
  "name": "mediaStatusTool",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "error": {
        "type": "string",
      },
      "id": {
        "type": "string",
      },
      "path": {
        "type": "string",
      },
      "status": {
        "type": "string",
      },
      "warning": {
        "type": "string",
      },
    },
    "type": "object",
  },
}
`;

exports[`the MCP tool contracts postSettingsTool keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Update Post Settings",
  },
  "description": "
Update the provider settings of an existing post (scheduled or draft) that was NOT published yet.
Only the settings change - the content and the publish date stay exactly as they are.
Find the post first (list your posts) and pass its "id" here.
The settings are merged into the existing ones, so only pass the keys you want to change; anything you don't pass stays as it is.
This relies on the integrationSchema tool [input:settings] to know which keys exist for the platform.
If validation fails, the result contains output.errors describing what to fix; the call can be retried with corrected parameters.
",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "The "id" of the post to update its settings",
        "type": "string",
      },
      "settings": {
        "description": "Settings keys to change, merged into the existing settings. This relies on the integrationSchema tool [input:settings]",
        "items": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "description": "Name of the settings key to change",
              "type": "string",
            },
            "value": {
              "description": "New value of the key, always prefer the id then label if possible. When the settings schema says a field is an id, pass the id returned by the channel tools, never the display label",
            },
          },
          "required": [
            "key",
          ],
          "type": "object",
        },
        "type": "array",
      },
    },
    "required": [
      "id",
      "settings",
    ],
    "type": "object",
  },
  "name": "postSettingsTool",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "output": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "postId": {
                "type": "string",
              },
              "publishDate": {
                "type": "string",
              },
            },
            "required": [
              "postId",
              "publishDate",
            ],
            "type": "object",
          },
          {
            "additionalProperties": false,
            "properties": {
              "errors": {
                "type": "string",
              },
            },
            "required": [
              "errors",
            ],
            "type": "object",
          },
        ],
      },
    },
    "required": [
      "output",
    ],
    "type": "object",
  },
}
`;

exports[`the MCP tool contracts postsListTool keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "List Posts",
  },
  "description": "
List the organization's posts scheduled to be published between two dates (the same data as the "List Posts" API endpoint).
Returns every post in the window whatever its state (scheduled, draft, published, errored).
"startDate" and "endDate" are required (UTC) - to list all upcoming posts, pass a wide window (for example from now to a year ahead).
Each item has an "id", its publish date, state, error (for errored posts), content, channel and current provider settings.
",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "customer": {
        "description": "Optional customer (group) id to filter the channels by",
        "type": "string",
      },
      "endDate": {
        "description": "End of the window (UTC), for example 2026-08-20T00:00:00",
        "type": "string",
      },
      "startDate": {
        "description": "Start of the window (UTC), for example 2026-07-20T00:00:00",
        "type": "string",
      },
    },
    "required": [
      "startDate",
      "endDate",
    ],
    "type": "object",
  },
  "name": "postsListTool",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "output": {
        "additionalProperties": false,
        "properties": {
          "posts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "content": {
                  "type": "string",
                },
                "error": {
                  "description": "Curated failure message for errored posts, null otherwise",
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "group": {
                  "type": "string",
                },
                "id": {
                  "description": "The post id",
                  "type": "string",
                },
                "integrationId": {
                  "type": "string",
                },
                "integrationName": {
                  "type": "string",
                },
                "platform": {
                  "type": "string",
                },
                "publishDate": {
                  "description": "UTC time",
                  "type": "string",
                },
                "settings": {
                  "description": "The post current provider settings",
                },
                "state": {
                  "description": "QUEUE, DRAFT, PUBLISHED or ERROR",
                  "type": "string",
                },
              },
              "required": [
                "id",
                "publishDate",
                "state",
                "error",
                "content",
                "group",
                "integrationId",
                "platform",
                "integrationName",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "posts",
        ],
        "type": "object",
      },
    },
    "required": [
      "output",
    ],
    "type": "object",
  },
}
`;

exports[`the MCP tool contracts triggerTool keeps its contract 1`] = `
{
  "_meta": undefined,
