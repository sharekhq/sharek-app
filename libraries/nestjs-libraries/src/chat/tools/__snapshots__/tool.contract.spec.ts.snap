exports[`the MCP tool contracts integrationSchedulePostTool keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Schedule Social Media Post",
  },
  "description": "
Use this when the user wants to create a draft, scheduled, or immediate social media post on their connected channels, based on the integrationSchema tool.
Examples of the input shape:

A single LinkedIn post with one comment
- socialPost array length will be one
- postsAndComments array length will be two (one for the post, one for the comment)

20 Facebook posts each on individual days without comments
- socialPost array length will be 20
- postsAndComments array length will be one

Do not use this to update or delete existing posts.
On success, each item in output contains a previewUrl the user can open to see the post.
If validation fails, the result contains output.errors describing what to fix; the call can be retried with corrected parameters.
",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "socialPost": {
        "description": "Individual post",
        "items": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "description": "The date of the post in UTC time",
              "type": "string",
            },
            "integrationId": {
              "description": "The id of the integration (not internal id)",
              "type": "string",
            },
            "isPremium": {
              "description": "If the integration is X, return if it's premium or not",
              "type": "boolean",
            },
            "postsAndComments": {
              "description": "first item is the post, every other item is the comments",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "attachments": {
                    "description": "The media of the post: either an uploaded media URL string, or { path, alt?, thumbnail?, thumbnailTimestamp? } where path is the uploaded media URL, alt is its alt text, thumbnail is the path of an uploaded jpeg/png (returned by uploadFromUrlTool) used as the video thumbnail / cover, and thumbnailTimestamp is the video frame to use as the cover, in milliseconds",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "alt": {
                              "type": "string",
                            },
                            "path": {
                              "type": "string",
                            },
                            "thumbnail": {
                              "type": "string",
                            },
                            "thumbnailTimestamp": {
                              "minimum": 0,
                              "type": "integer",
                            },
                          },
                          "required": [
                            "path",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    "type": "array",
                  },
                  "content": {
                    "description": "The content of the post, HTML, Each line must be wrapped in <p> here is the possible tags: h1, h2, h3, u, strong, li, ul, p (you can't have u and strong together), img (<img src="...">) only when the integration rules say pictures go inside the content, and span only for a mention in the exact format given by a mention tool from the integrationSchema tools",
                    "type": "string",
                  },
                },
                "required": [
                  "content",
                  "attachments",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "settings": {
              "description": "This relies on the integrationSchema tool to get the settings [input:settings]",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "description": "Name of the settings key to pass",
                    "type": "string",
                  },
                  "value": {
                    "description": "Value of the key, always prefer the id then label if possible. When the settings schema says a field is an id, pass the id returned by the channel tools, never the display label",
                  },
                },
                "required": [
                  "key",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "shortLink": {
              "description": "If the post has a link inside, we can ask the user if they want to add a short link",
              "type": "boolean",
            },
            "type": {
              "description": "The type of the post, if we pass now, we should pass the current date also",
              "enum": [
                "draft",
                "schedule",
                "now",
              ],
              "type": "string",
            },
          },
          "required": [
            "integrationId",
            "isPremium",
            "date",
            "shortLink",
            "type",
            "postsAndComments",
            "settings",
          ],
          "type": "object",
        },
        "type": "array",
      },
    },
    "required": [
      "socialPost",
    ],
    "type": "object",
  },
  "name": "integrationSchedulePostTool",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "output": {
        "anyOf": [
          {
            "items": {
              "additionalProperties": false,
              "properties": {
                "integration": {
                  "type": "string",
                },
                "postId": {
                  "type": "string",
                },
                "previewUrl": {
                  "description": "Public preview page of the created post, share it with the user",
                  "type": "string",
                },
              },
              "required": [
                "postId",
                "integration",
                "previewUrl",
              ],
              "type": "object",
            },
            "type": "array",
          },
          {
            "additionalProperties": false,
            "properties": {
              "errors": {
                "type": "string",
              },
            },
            "required": [
              "errors",
            ],
            "type": "object",
          },
        ],
      },
    },
    "required": [
      "output",
    ],
    "type": "object",
  },
}
`;

exports[`the MCP tool contracts integrationSchema keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Get Integration Schema",
  },
  "description": "Everytime we want to schedule a social media post, we need to understand the schema of the integration.
         This tool helps us get the schema of the integration.
         Sometimes we might get a schema back the requires some id, for that, you can get information from 'tools'
         And use the triggerTool function.
         'tools' can also include a mention lookup, use it to tag people or pages in the post content.
        ",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "isPremium": {
        "description": "is this the user premium? if not, set to false",
        "type": "boolean",
      },
      "platform": {
        "description": "platform identifier (example-provider)",
        "type": "string",
      },
    },
    "required": [
      "isPremium",
      "platform",
    ],
    "type": "object",
  },
  "name": "integrationSchema",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "output": {
        "additionalProperties": false,
        "properties": {
          "maxLength": {
            "description": "The maximum length of a post / comment",
            "type": "number",
          },
          "rules": {
            "type": "string",
          },
          "settings": {
            "description": "List of settings need to be passed to schedule a post",
          },
          "tools": {
            "description": "Sometimes settings require some id, tags and stuff, if you don't have, trigger the \`triggerTool\` function from the tools list [output:callable-tools]",
            "items": {
              "additionalProperties": false,
              "properties": {
                "dataSchema": {
                  "description": "This will be passed to schedulePostTool [output:settings]",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "description": {
                        "description": "Description of the setting key",
                        "type": "string",
                      },
                      "key": {
                        "description": "Name of the settings key to pass",
                        "type": "string",
                      },
                      "type": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "key",
                      "description",
                      "type",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "description": {
                  "description": "Description of the tool",
                  "type": "string",
                },
                "methodName": {
                  "description": "Method to call to get the information",
                  "type": "string",
                },
              },
              "required": [
                "description",
                "methodName",
                "dataSchema",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "rules",
          "maxLength",
          "tools",
        ],
        "type": "object",
      },
    },
    "required": [
      "output",
    ],
    "type": "object",
  },
}
`;

exports[`the MCP tool contracts mediaListTool keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "List Media",
  },
  "description": "List the media (images and videos) already uploaded to the media library, newest first, 32 per page, optionally searched by original filename.
Use the returned path as an attachment URL in integrationSchedulePostTool instead of uploading the file again.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "page": {
        "description": "Page number, starting at 1",
        "minimum": 1,
        "type": "integer",
      },
      "search": {
        "description": "Filter by original filename (case-insensitive contains)",
