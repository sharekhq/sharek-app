exports[`the MCP tool contracts uploadWidgetTool keeps its contract 1`] = `
{
  "_meta": {
    "ui": {
      "resourceUri": "ui://postiz/upload",
    },
  },
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Upload Media From Device",
  },
  "description": "Show the user an upload widget to add images or videos from their own device to the media library.
Use this when the user wants to attach a local file to a post. When the media is already available on a public URL, use uploadFromUrlTool instead.
The widget is only displayed by apps that support MCP Apps (interactive UI); in any other app no widget appears, and local files go through the Sharek CLI (sharek upload <file>, https://docs.sharek.app/cli/introduction) or the public API (POST /public/v1/upload with an API key, https://docs.sharek.app/api/introduction). uploadFromUrlTool is only for public URLs.
Returns a sessionId: the files the user uploads are reported in the conversation, and can also be read with uploadWidgetStatusTool.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {},
    "type": "object",
  },
  "name": "uploadWidgetTool",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "error": {
        "type": "string",
      },
      "sessionId": {
        "type": "string",
      },
    },
    "type": "object",
  },
}
`;

