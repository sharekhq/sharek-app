exports[`the MCP tool contracts videoStatusTool keeps its contract 1`] = `
{
  "_meta": undefined,
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Video Generation Status",
  },
  "description": "Check the status of a video generation started with 'generateVideoTool', using the jobId it returned.
                    Call it only when the user asks about a video they started earlier; report the status once and end your reply — never loop or wait for it to finish.
                    While the status is "pending", tell the user it is still rendering and will appear in their Media library.
                    When the status is "completed" the result contains the hosted video url, which can be used as a post attachment.
                    When the status is "failed" the result contains the error message.
      ",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "jobId": {
        "description": "The jobId returned by generateVideoTool",
        "type": "string",
      },
    },
    "required": [
      "jobId",
    ],
    "type": "object",
  },
  "name": "videoStatusTool",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "error": {
        "type": "string",
      },
      "id": {
        "type": "string",
      },
      "status": {
        "enum": [
          "pending",
          "completed",
          "failed",
        ],
        "type": "string",
      },
      "url": {
        "type": "string",
      },
    },
    "type": "object",
  },
}
`;
